# Cloudflare Pages response headers.
#
# Served for every path. Cloudflare applies these on top of its own defaults,
# so a header set here overrides the default of the same name (this is how the
# blanket Access-Control-Allow-Origin: * gets narrowed below).
#
# CSP notes:
#   script-src keeps 'unsafe-inline' because this is a static export: Next
#   inlines its own hydration payload as <script> blocks and there is no
#   server to mint a per-request nonce.
#   The one third-party origin allowed to run a script is
#   static.cloudflareinsights.com: Cloudflare injects its Web Analytics beacon
#   into the HTML at the edge. The beacon reports to /cdn-cgi/rum on this same
#   origin, so connect-src 'self' already covers it and needs no third-party
#   entry. It is cookieless and is declared in /privacy; removing this origin
#   silently disables measurement, so change the two together.
#   style-src keeps 'unsafe-inline' for the same reason (Tailwind critical CSS
#   plus React inline style attributes) and allows the Google Fonts stylesheet.
#   font-src allows fonts.gstatic.com, where that stylesheet points. Serving
#   the fonts from this origin instead would let both entries drop.

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Access-Control-Allow-Origin: https://innoviasystems.io

# Build output is content-hashed, so it can be cached hard and forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
